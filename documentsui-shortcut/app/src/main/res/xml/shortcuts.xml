<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="download"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_download"
        android:shortcutShortLabel="@string/shortcut_download">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.documentsui.launcher.MainActivity"
            android:targetPackage="com.documentsui.shortcut">
